{
  "name": "opensandbox-cluster",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "test": "bun test src web --isolate",
    "typecheck": "tsc-rs -p tsconfig.json --noEmit --incremental false && tsc-rs -p tsconfig.web.json --noEmit --incremental false",
    "build": "bun build src/index.ts --outfile dist/index.js --target=bun",
    "dev:web": "vite --config vite.config.ts",
    "build:web": "vite build --config vite.config.ts",
    "start": "bun run src/index.ts",
    "lint": "biome check src web *.ts *.json",
    "format": "biome format --write src web *.ts *.json",
    "precheck": "bun run lint && bun run typecheck && bun run test && bun run build:web && bun run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts"
  },
  "dependencies": {
    "@elysiajs/openapi": "1.4.15",
    "@noble/ciphers": "2.2.0",
    "drizzle-orm": "0.45.2",
    "elysia": "1.4.28",
    "smol-toml": "1.7.1",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.0",
    "@tanstack/react-router": "1.170.11",
    "@types/bun": "1.3.14",
    "@vitejs/plugin-react": "6.0.2",
    "happy-dom": "20.10.1",
    "i18next": "26.3.1",
    "lucide-react": "1.17.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "4.3.0",
    "vite": "8.2.2",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-slot": "1.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0",
    "@biomejs/biome": "2.4.16",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "tsc-rs": "0.6.0"
  },
  "license": "Apache-2.0",
  "engines": {
    "bun": ">=1.4.3"
  }
}
